# Example environment variables for Cretivox
# Copy this file to `.env.local` and fill values as needed.

# Optional client-side API URL (if not using the built-in proxy)
NEXT_PUBLIC_CRETIVOX_API_URL=https://api.cretivox.dev/auth/login

# Example (DummyJSON testing)
# NEXT_PUBLIC_CRETIVOX_API_URL=https://dummyjson.com/user/login
